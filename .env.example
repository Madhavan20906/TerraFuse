# TerraFuse Environment Configuration

# Gemini AI Extraction (Recommended)
GEMINI_API_KEY=

# Alternative: OpenAI Extraction
OPENAI_API_KEY=

# Backend Port (Default: 5000)
PORT=5000

# Optional Managed PostgreSQL (If omitted, uses local embedded PGlite in .data/pgdata)
# DATABASE_URL=postgresql://user:password@localhost:5432/terrafuse
