{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/terrafuse run build",
  "outputDirectory": "artifacts/terrafuse/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://terrafuse-backend.onrender.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}